# Extra specs for the `rocm7` flavor (one per line; `#` comments allowed).
# Added via `spack add` on top of the base environment. The amdgpu_target list
# comes from flavors/rocm7.yaml (applied only to packages that expose it).
#
# Upstream Spack's `hip` builds the whole ROCm stack from source, which costs
# hours and more disk than a CI runner has. spack_repo/acts/packages/ overrides
# `hip`, `llvm-amdgpu`, `hsa-rocr-dev` and `comgr` with binary packages that
# unpack AMD's rpms instead (~456 MB download, ~2.1 GB installed). Those names
# are hardcoded in depends_on upstream (HIP is not a virtual), hence overrides
# rather than a separate package.

# ROCm HIP toolchain: a complete /opt/rocm-style root (hipcc, clang, device
# libs, runtime, CMake config packages).
hip

# traccc GPU stack. vecmem uses its own `+hip` variant; covfie is a
# ROCmPackage so it's `+rocm` (maps to COVFIE_PLATFORM_HIP) and also pulls in
# llvm-amdgpu + hsa-rocr-dev. Both are root specs in the base spack.yaml, so
# these are `spack change` merges that only flip the accelerator variant — the
# versions stay pinned in one place, the base.
vecmem +hip
covfie +rocm

# rocThrust — the HIP-side Thrust traccc resolves via find_package(rocthrust)
# when TRACCC_BUILD_HIP is on. Pinned to match hip@7.2.3 from rocm7.yaml,
# since rocthrust@X depends_on hip@X exactly — which is what picks the ROCm
# patch release for the whole flavor: AMD ships rhel8 rpms for 7.2 through
# 7.2.4, but upstream Spack only has rocthrust 7.2.0/7.2.1/7.2.3, so 7.2.3 is
# the newest 7.2.x the two agree on. Its closure is what forced the
# comgr override: rocthrust -> rocprim -> comgr, and the builtin comgr can't
# build from AMD's rpm layout (wants clang's CMake package where the rpm
# doesn't ship it); AMD's comgr rpm is already unpacked by `hip`.
rocthrust@7.2.3

# rocRAND. Same exact `depends_on("hip@X")` pin as rocthrust, so it moves with
# the flavor's ROCm version and constrains which patch release is reachable in
# the same way (builtin has 7.2.0/7.2.1/7.2.3 here too).
#
# This is the one spec in the flavor that needs a Fortran compiler: builtin
# rocrand carries an unconditional `depends_on("fortran", type="build")` from
# Spack's generated language dependencies. It is build-only and satisfied by
# the base image's gfortran (the ubuntu2604 image ships gfortran-15 alongside
# gcc@15.2.0), so it resolves to the same external gcc rather than building one
# — but it does mean this flavor now requires an image with Fortran.
#
rocrand@7.2.3

# hipRAND, the portable wrapper consumers reach through find_package(hiprand).
# A separate package from rocrand upstream, so both are needed: this one only
# supplies the hipRAND interface and delegates to a backend.
#
# `+rocm` is explicit even though it is the default: hiprand is both a
# CudaPackage and a ROCmPackage, exactly one of +cuda/+rocm is required, and
# spelling it out keeps this readable next to covfie above. It pulls
# rocrand@7.2.3 (same exact-version pin) and forwards amdgpu_target to it, so
# the two stay consistent with the flavor's gfx targets on their own.
#
# Note the source is large for what it is: from 7.1.1 on, url_for_version
# switches from the per-project hipRAND tarball to the whole ROCm/rocm-libraries
# monorepo, and the package builds one subdirectory out of it.
hiprand@7.2.3 +rocm

# Alpaka, traccc's portability backend. `serial,hip` rather than `hip`, since a
# multi-valued variant substitutes wholesale on merge and would drop the serial
# backend the base spack.yaml asks for; `hip_only` conflicts with every other
# backend and so cannot express this at all.
alpaka backend=serial,hip

# Deliberately absent, as in cuda13: ACTS vendors/FetchContents traccc,
# detray and algebra-plugins, so none is a system package. Vc is off on both
# paths; dfelibs is dead upstream.
#
# Worth noting: ACTS itself has no HIP/ROCm build path today (only
# enable_cuda(), never wiring TRACCC_BUILD_HIP). The HIP backend lives in
# vendored traccc but nothing in ACTS turns it on — this flavor currently
# supports a standalone traccc/detray HIP build, not an ACTS one.
